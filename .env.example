# Copy to .env.local in each app. Never commit real keys.
# Local values are printed by `pnpm db:start`; cloud values are in Supabase → Project Settings → API.

# --- web apps (apps/ops-dashboard, apps/client-portal, apps/website) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Ops dashboard ONLY (server side, for staff invites). Never in a mobile app or a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- mobile apps (apps/client-mobile, apps/rider-mobile) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase Edge Function secrets (set with `npx supabase secrets set KEY=value`) ---
# SEND_SMS_HOOK_SECRET=v1,whsec_...       (Supabase → Authentication → Hooks → Send SMS → generate secret)
# HUBTEL_SMS_CLIENT_ID=
# HUBTEL_SMS_CLIENT_SECRET=
# HUBTEL_SMS_SENDER_ID=QCS                (must be approved on your Hubtel account)

# --- booking API (apps/client-portal, server side) ---
# Google Maps Platform server key: enable Routes API, Places API (New), Geocoding API. Restrict it to those APIs.
GOOGLE_MAPS_SERVER_KEY=
# Footer text printed on labels, e.g. "Track at qcs.com.gh"
QCS_LABEL_FOOTER=
# --- customer app ---
# Where the app reaches the booking API (the business portal). On a phone use your computer's Wi-Fi IP, e.g. http://192.168.1.20:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
# Android Google Maps key for app builds (Maps SDK for Android). Not needed in Expo Go.
GOOGLE_MAPS_ANDROID_KEY=
