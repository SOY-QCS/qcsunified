# Copy to .env.local in each app. Never commit real keys.
# Local Supabase prints these after `pnpm db:start`; cloud values are in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Server only (Edge Functions). NEVER put this in an app.
SUPABASE_SERVICE_ROLE_KEY=
