# Copy to .env.local in each app. Never commit real keys.
# Local values are printed by `pnpm db:start`; cloud values are in Supabase → Project Settings → API.

# --- web apps (apps/ops-dashboard, apps/client-portal, apps/website) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Ops dashboard ONLY (server side, for staff invites). Never in a mobile app or a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- mobile apps (apps/client-mobile, apps/rider-mobile) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase Edge Function secrets (set with `npx supabase secrets set KEY=value`) ---
# SEND_SMS_HOOK_SECRET=v1,whsec_...       (Supabase → Authentication → Hooks → Send SMS → generate secret)
# HUBTEL_SMS_CLIENT_ID=
# HUBTEL_SMS_CLIENT_SECRET=
# HUBTEL_SMS_SENDER_ID=QCS                (must be approved on your Hubtel account)

# --- booking API (apps/client-portal, server side) ---
# Google Maps Platform server key: enable Routes API, Places API (New), Geocoding API. Restrict it to those APIs.
GOOGLE_MAPS_SERVER_KEY=
# Footer text printed on labels, e.g. "Track at qcs.com.gh"
QCS_LABEL_FOOTER=
# --- customer app ---
# Where the app reaches the booking API (the business portal). On a phone use your computer's Wi-Fi IP, e.g. http://192.168.1.20:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
# Android Google Maps key for app builds (Maps SDK for Android). Not needed in Expo Go.
GOOGLE_MAPS_ANDROID_KEY=

# --- Hubtel payments (business portal server; ops dashboard needs the same for payouts) ---
HUBTEL_API_ID=
HUBTEL_API_KEY=
HUBTEL_MERCHANT_ACCOUNT=          # POS Sales ID / merchant account number
# Optional — confirm the exact URLs in the integration pack Hubtel gives you:
HUBTEL_CHECKOUT_URL=https://payproxyapi.hubtel.com/items/initiate
HUBTEL_STATUS_URL=                # e.g. https://api-txnstatus.hubtel.com/transactions/{merchant}/status (needs whitelisted server IPs)
HUBTEL_SEND_MONEY_URL=            # e.g. https://smp.hubtel.com/api/merchants/<prepaid account>/send/mobilemoney
# Long random secret: generate with `openssl rand -hex 32`. Put the SAME value in the portal and ops dashboard.
HUBTEL_CALLBACK_TOKEN=
# Public address of the business portal (Hubtel sends people back here and calls our callbacks)
PUBLIC_API_URL=http://localhost:3001
# Secret for the scheduled reconcile job (Vercel Cron sends it automatically when set in the project)
CRON_SECRET=
# Local testing only: fake Hubtel checkout page when no Hubtel keys are set (ignored in production)
DEV_FAKE_PAYMENTS=1

# --- Phase 5: dispatch & WhatsApp (Supabase Edge Function secrets: `supabase secrets set NAME=value`) ---
# WhatsApp Cloud API (Meta Business → WhatsApp → API setup)
WHATSAPP_TOKEN=                   # permanent system-user access token
WHATSAPP_PHONE_NUMBER_ID=         # the QCS WhatsApp number's ID (not the phone number itself)
WHATSAPP_APP_SECRET=              # Meta app secret: used to check messages really come from Meta
WHATSAPP_VERIFY_TOKEN=            # any long random text; type the same into Meta's webhook settings
WHATSAPP_API_VERSION=v21.0
# Optional road-time ranking of the 5 nearest riders (Google Routes API, costs money per call)
GOOGLE_MAPS_SERVER_KEY=
DISPATCH_RANK_SECRET=             # long random text, `openssl rand -hex 32`
