{
  "expo": {
    "name": "QCS Rider",
    "slug": "qcs-rider-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gh.qcs.rider"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#df6518",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "gh.qcs.rider"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "qcs-rider",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "QCS Rider uses your camera to photograph your documents, your vehicle and parcels.",
          "photosPermission": "QCS Rider needs your photos to upload your documents."
        }
      ]
    ]
  }
}
