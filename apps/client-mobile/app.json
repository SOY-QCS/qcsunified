{
  "expo": {
    "name": "QCS",
    "slug": "qcs-client-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gh.qcs.client"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#df6518",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "gh.qcs.client"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "qcs-client",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "QCS uses your camera to photograph your ID for verification.",
          "photosPermission": "QCS needs your photos to upload your ID document."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "QCS uses your location to set your pickup point on the map."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#df6518"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
